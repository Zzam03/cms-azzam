# Salin file ini jadi ".env" (tanpa .example), lalu isi nilainya.
# JANGAN upload file .env ke GitHub.

PORT=3000

# Kunci rahasia untuk menandatangani login (JWT). Isi dengan teks acak PANJANG (min. 32 karakter).
# Cara membuatnya: jalankan  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=a998a991fa55a04adff47b529147d371db9d7d443aad6fe554ed0a58466c5767

# Akun admin pertama. Dibuat otomatis saat server dijalankan pertama kali.
# Password disimpan dalam bentuk hash bcrypt, bukan teks asli.
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@simpul.co.id
ADMIN_PASSWORD=Simpul123

# Ubah ke production saat dipasang di hosting (cookie login jadi wajib HTTPS)
NODE_ENV=development
